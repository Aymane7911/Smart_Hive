generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────
model User {
  id         Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  firstname  String?
  lastname   String?
  role       String  @default("user")

  phone      String?
  address    String?
  city       String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases    Purchase[]
  calibrations Calibration[]

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────
// ORDER INQUIRY
// Submitted from /order page — no account needed.
// Admin reviews → ships box with serial number → customer registers.
// ─────────────────────────────────────────────────────────────────
model Order {
  id          Int       @id @default(autoincrement())
  fullName    String
  email       String
  phone       String?
  masterHives Int       @default(1)
  normalHives Int       @default(0)
  country     String?
  city        String?
  message     String?

  // new | reviewed | shipped | rejected
  status      String    @default("new")
  adminNotes  String?
  shippedAt   DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("orders")
  @@index([email])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────
// DEVICE
// ─────────────────────────────────────────────────────────────────
model Device {
  id               Int       @id @default(autoincrement())
  serialNumber     String    @unique
  azureContainerId String    @unique
  hiveCount        Int       @default(1)
  model            String    @default("STANDARD")
  status           String    @default("unclaimed")
  ownerId          Int?
  claimedAt        DateTime?
  createdByAdminId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  purchases Purchase[]

  @@map("devices")
  @@index([serialNumber])
  @@index([status])
  @@index([ownerId])
}

// ─────────────────────────────────────────────────────────────────
// PURCHASE
// Created automatically when a user registers with a serial number.
// Admin grants dashboard access here.
// ─────────────────────────────────────────────────────────────────
model Purchase {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId Int?
  device   Device? @relation(fields: [deviceId], references: [id])

  masterHives Int    @default(0)
  normalHives Int    @default(0)
  totalAmount Float  @default(0)

  fullName   String  @default("")
  email      String  @default("")
  phone      String?
  address    String?
  city       String?
  country    String?
  postalCode String?

  cardLastFour  String?
  cardName      String?
  cardExpiry    String?
  paymentMethod String? @default("card")

  status          String    @default("pending")
  accessGranted   Boolean   @default(false)
  accessGrantedAt DateTime?
  assignedContainers String[]

  purchaseDate DateTime  @default(now())
  approvedAt   DateTime?
  updatedAt    DateTime  @updatedAt
  adminNotes   String?

  @@map("purchases")
  @@index([userId])
  @@index([status])
  @@index([email])
  @@index([deviceId])
}

// ─────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────
model Session {
  id        String   @id @default(cuid())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
  @@index([userId])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────────
// CONTAINER
// ─────────────────────────────────────────────────────────────────
model Container {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)
  latitude    Float?
  longitude   Float?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("containers")
}

// ─────────────────────────────────────────────────────────────────
// APIARY LOCATION
// ─────────────────────────────────────────────────────────────────
model ApiaryLocation {
  id          Int     @id @default(autoincrement())
  containerId String  @unique
  latitude    Float
  longitude   Float
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("apiary_locations")
  @@index([containerId])
}

// ─────────────────────────────────────────────────────────────────
// CALIBRATION
// ─────────────────────────────────────────────────────────────────
model Calibration {
  id          Int    @id @default(autoincrement())
  userId      Int
  containerId String
  hiveNumber  Int

  tempExternalOffset     Float  @default(0)
  tempExternalVisualized Float?
  tempExternalReal       Float?
  tempInternalOffset     Float  @default(0)
  tempInternalVisualized Float?
  tempInternalReal       Float?
  humidityOffset         Float  @default(0)
  humidityVisualized     Float?
  humidityReal           Float?
  weightOffset           Float  @default(0)
  weightVisualized       Float?
  weightReal             Float?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, containerId, hiveNumber])
  @@map("calibrations")
  @@index([userId, containerId])
  @@index([containerId])
}
